diff --git a/src/c_api_core_main.zig b/src/c_api_core_main.zig
new file mode 100644
index 0000000..da920a8
--- /dev/null
+++ b/src/c_api_core_main.zig
@@ -0,0 +1,134 @@
+const std = @import("std");
+const embedded = @import("core/embedding/runtime.zig");
+
+const Runtime = embedded.Runtime;
+
+pub const panic = std.debug.FullPanic(panicWithoutTrace);
+
+fn panicWithoutTrace(msg: []const u8, first_trace_addr: ?usize) noreturn {
+    _ = msg;
+    _ = first_trace_addr;
+    @trap();
+}
+
+pub export fn fx_abi_version() callconv(.c) u32 {
+    return embedded.abi_version;
+}
+
+const Options = extern struct {
+    abi_version: u32,
+    credential: ?[*]const u8,
+    credential_length: usize,
+    model: ?[*]const u8,
+    model_length: usize,
+    home: ?[*]const u8,
+    home_length: usize,
+    workspace_root: ?[*]const u8,
+    workspace_root_length: usize,
+    gateway_chat_url: ?[*]const u8,
+    gateway_chat_url_length: usize,
+};
+
+fn required(ptr: ?[*]const u8, len: usize) ?[]const u8 {
+    if (ptr == null or len == 0) return null;
+    return ptr.?[0..len];
+}
+
+fn optional(ptr: ?[*]const u8, len: usize) ?[]const u8 {
+    if (len == 0) return null;
+    if (ptr == null) return null;
+    return ptr.?[0..len];
+}
+
+pub export fn fx_runtime_create(options: ?*const Options, runtime_out: ?*?*Runtime) callconv(.c) i32 {
+    const opts = options orelse return -1;
+    const out = runtime_out orelse return -1;
+    out.* = null;
+    if (opts.abi_version != embedded.abi_version) return -1;
+    const runtime = embedded.create(.{
+        .credential = required(opts.credential, opts.credential_length) orelse return -1,
+        .model = optional(opts.model, opts.model_length),
+        .home = required(opts.home, opts.home_length) orelse return -1,
+        .workspace_root = required(opts.workspace_root, opts.workspace_root_length) orelse return -1,
+        .gateway_chat_url = optional(opts.gateway_chat_url, opts.gateway_chat_url_length),
+    }) catch |err| return switch (err) {
+        error.TooManyRuntimes => -2,
+        error.OutOfMemory => -3,
+        error.ThreadFailed => -4,
+        else => -1,
+    };
+    out.* = runtime;
+    return 0;
+}
+
+pub export fn fx_runtime_write(runtime: ?*Runtime, bytes: ?[*]const u8, length: usize) callconv(.c) i32 {
+    const value = runtime orelse return -1;
+    if (length > 0 and bytes == null) return -1;
+    embedded.write(value, if (length == 0) &.{} else bytes.?[0..length]) catch |err| return switch (err) {
+        error.InputClosed => -6,
+        error.InputQueueFull => -5,
+        error.OutOfMemory => -3,
+    };
+    return 0;
+}
+
+pub export fn fx_runtime_close_input(runtime: ?*Runtime) callconv(.c) void {
+    if (runtime) |value| embedded.closeInput(value);
+}
+
+pub export fn fx_runtime_abort_fetch(runtime: ?*Runtime) callconv(.c) void {
+    if (runtime) |value| embedded.abortFetch(value);
+}
+
+pub export fn fx_runtime_output_available(runtime: ?*Runtime) callconv(.c) usize {
+    return if (runtime) |value| embedded.outputAvailable(value) else 0;
+}
+
+pub export fn fx_runtime_drain(runtime: ?*Runtime, destination: ?[*]u8, capacity: usize) callconv(.c) usize {
+    const value = runtime orelse return 0;
+    if (capacity == 0 or destination == null) return 0;
+    return embedded.drain(value, destination.?[0..capacity]);
+}
+
+pub export fn fx_runtime_take_fetch(runtime: ?*Runtime, destination: ?[*]u8, capacity: usize) callconv(.c) isize {
+    const value = runtime orelse return 0;
+    return embedded.takeFetch(value, if (capacity == 0 or destination == null) &.{} else destination.?[0..capacity]);
+}
+
+pub export fn fx_runtime_fetch_active(runtime: ?*Runtime, handle: i32) callconv(.c) bool {
+    return if (runtime) |value| embedded.fetchActive(value, handle) else false;
+}
+
+fn fetchResult(value: embedded.FetchOperationResult) u8 {
+    return @intFromEnum(value);
+}
+
+pub export fn fx_runtime_start_fetch_response(runtime: ?*Runtime, handle: i32, status: u16) callconv(.c) u8 {
+    return if (runtime) |value| fetchResult(embedded.startFetch(value, handle, status)) else 0;
+}
+
+pub export fn fx_runtime_push_fetch_response(runtime: ?*Runtime, handle: i32, bytes: ?[*]const u8, length: usize) callconv(.c) u8 {
+    const value = runtime orelse return 0;
+    if (length > 0 and bytes == null) return 0;
+    return fetchResult(embedded.pushFetch(value, handle, if (length == 0) &.{} else bytes.?[0..length]) catch return 2);
+}
+
+pub export fn fx_runtime_finish_fetch(runtime: ?*Runtime, handle: i32) callconv(.c) u8 {
+    return if (runtime) |value| fetchResult(embedded.finishFetch(value, handle)) else 0;
+}
+
+pub export fn fx_runtime_fail_fetch(runtime: ?*Runtime, handle: i32) callconv(.c) u8 {
+    return if (runtime) |value| fetchResult(embedded.failFetch(value, handle)) else 0;
+}
+
+pub export fn fx_runtime_exited(runtime: ?*Runtime) callconv(.c) bool {
+    return if (runtime) |value| embedded.exited(value) else true;
+}
+
+pub export fn fx_runtime_exit_code(runtime: ?*Runtime) callconv(.c) u8 {
+    return if (runtime) |value| embedded.exitCode(value) else 1;
+}
+
+pub export fn fx_runtime_destroy(runtime: ?*Runtime) callconv(.c) void {
+    if (runtime) |value| embedded.destroy(value);
+}
