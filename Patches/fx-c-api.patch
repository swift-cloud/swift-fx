+#ifndef LIBFX_H
+#define LIBFX_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FX_ABI_VERSION 1u
+
+typedef struct fx_runtime fx_runtime_t;
+
+typedef enum fx_status {
+    FX_OK = 0,
+    FX_ERROR_INVALID_ARGUMENT = -1,
+    FX_ERROR_LIMIT = -2,
+    FX_ERROR_OUT_OF_MEMORY = -3,
+    FX_ERROR_THREAD = -4,
+    FX_ERROR_BACKPRESSURE = -5,
+    FX_ERROR_CLOSED = -6,
+    FX_ERROR_BUFFER_TOO_SMALL = -7,
+    FX_ERROR_STALE = -8
+} fx_status_t;
+
+typedef enum fx_fetch_result {
+    FX_FETCH_STALE = 0,
+    FX_FETCH_APPLIED = 1,
+    FX_FETCH_BACKPRESSURE = 2
+} fx_fetch_result_t;
+
+typedef struct fx_runtime_options {
+    uint32_t abi_version;
+    const uint8_t *credential;
+    size_t credential_length;
+    const uint8_t *model;
+    size_t model_length;
+    const uint8_t *home;
+    size_t home_length;
+    const uint8_t *workspace_root;
+    size_t workspace_root_length;
+    const uint8_t *gateway_chat_url;
+    size_t gateway_chat_url_length;
+} fx_runtime_options_t;
+
+uint32_t fx_abi_version(void);
+fx_status_t fx_runtime_create(const fx_runtime_options_t *options, fx_runtime_t **runtime_out);
+fx_status_t fx_runtime_write(fx_runtime_t *runtime, const uint8_t *bytes, size_t length);
+void fx_runtime_close_input(fx_runtime_t *runtime);
+void fx_runtime_abort_fetch(fx_runtime_t *runtime);
+size_t fx_runtime_output_available(fx_runtime_t *runtime);
+size_t fx_runtime_drain(fx_runtime_t *runtime, uint8_t *destination, size_t capacity);
+ptrdiff_t fx_runtime_take_fetch(fx_runtime_t *runtime, uint8_t *destination, size_t capacity);
+bool fx_runtime_fetch_active(fx_runtime_t *runtime, int32_t fetch_handle);
+fx_fetch_result_t fx_runtime_start_fetch_response(fx_runtime_t *runtime, int32_t fetch_handle, uint16_t status);
+fx_fetch_result_t fx_runtime_push_fetch_response(fx_runtime_t *runtime, int32_t fetch_handle, const uint8_t *bytes, size_t length);
+fx_fetch_result_t fx_runtime_finish_fetch(fx_runtime_t *runtime, int32_t fetch_handle);
+fx_fetch_result_t fx_runtime_fail_fetch(fx_runtime_t *runtime, int32_t fetch_handle);
+bool fx_runtime_exited(fx_runtime_t *runtime);
+uint8_t fx_runtime_exit_code(fx_runtime_t *runtime);
+void fx_runtime_destroy(fx_runtime_t *runtime);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
